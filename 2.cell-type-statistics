# ===========统计每个大类的细胞数量 & 占比========================
cell_count = pd.crosstab(kidney_adata.obs['orig.ident'], kidney_adata.obs['cell_group'])
# 计算占比（每个样本内部百分比）
cell_ratio = cell_count.div(cell_count.sum(axis=1), axis=0) * 100
print("=== 每个样本的细胞数量 ===")
print(cell_count)
print("\n=== 每个样本的细胞占比(%) ===")
print(cell_ratio.round(2))
# 绘制堆叠百分比柱状图
plt.rcParams['figure.dpi'] = 300
plt.figure(figsize=(6, 5))

# 配色（SCI 友好配色）
colors = [
    "#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b"
]

# 画图
cell_ratio.plot(
    kind='bar', stacked=True, color=colors, ax=plt.gca()
)

plt.title('Cell Type Composition (WT vs AML)', fontweight='bold', fontsize=14)
plt.ylabel('Cell Ratio (%)', fontweight='bold')
plt.xlabel('Group', fontweight='bold')
plt.xticks(rotation=0)
plt.legend(loc='upper right', bbox_to_anchor=(1.3, 1), frameon=False)
plt.tight_layout()
# plt.savefig(outdir + "五大类细胞的各样本的细胞比例组成.pdf")
plt.show()

